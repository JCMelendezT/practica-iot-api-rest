# =============================================================================
# Plantilla de variables de entorno.
#
# Copiala y completala. El archivo real (.env) esta en .gitignore y NUNCA
# se sube al repositorio: el token de Ubidots es una credencial personal.
#
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows PowerShell)
#
# En la VM no hace falta el archivo: alcanza con exportar la variable.
# -----------------------------------------------------------------------------

# Token de Ubidots.
# Donde se obtiene: Ubidots -> Dispositivos -> tu dispositivo -> pestana
# "Ajustes" -> "Token de API".
# Empieza con el prefijo BBUS- y es una cadena larga: no lo publiques.
UBIDOTS_TOKEN=BBUS-pega-aqui-tu-token

# Etiqueta del dispositivo en Ubidots (debe coincidir con el nombre real
# que le pusiste en la consola de Ubidots, no con "machine" a ciegas).
UBIDOTS_DEVICE_LABEL=machine
